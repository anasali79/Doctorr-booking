# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000,http://localhost:3001
APP_BASE_URL=https://doctorr-booking-1.onrender.com

# Auth
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/schedula?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=schedula

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Brevo Email Service Integration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=support@doctorbook.app
BREVO_FROM_NAME=CareUp

# ==============================================================================
# VONAGE (NEXMO) MULTI-CHANNEL CONFIGURATION (SMS & WhatsApp Messages API)
# ==============================================================================
# SMS Credentials (REST SMS API)
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
VONAGE_SMS_FROM=CareUp

# WhatsApp Messages API Credentials (Application JWT Authentication)
VONAGE_APPLICATION_ID=your_vonage_application_uuid_here
VONAGE_PRIVATE_KEY_PATH=/etc/secrets/private.key
# Optional: Inline private key if not using file mounting
# VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# WhatsApp Numbers & Sandbox Mode
VONAGE_WHATSAPP_FROM=14157386170
VONAGE_USE_SANDBOX=true
VONAGE_TEST_PHONE=917987087000

# Webhook Security
NOTIFICATION_WEBHOOK_SECRET=your_notification_webhook_secret_here
